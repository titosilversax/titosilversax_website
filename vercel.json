{
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/titodreamingwithme", "permanent": false }
  ],
  "rewrites": [
    { "source": "/titodreamingwithme/:path*", "destination": "/titodreamingwithme/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
